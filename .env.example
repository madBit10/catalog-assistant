# Copy to .env and fill in real values. Never commit .env.
POSTGRES_USER=catalog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=catalog
DATABASE_URL=postgresql+psycopg2://catalog:change-me@localhost:5432/catalog
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=your-anthropic-api-key
JWT_SECRET=generate-a-long-random-string

# Optional: background removal model (default isnet-general-use; see experiments/2026-11-14_rembg_models)
# REMBG_MODEL=birefnet-general-lite
