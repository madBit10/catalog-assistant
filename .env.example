# Copy to .env and fill in real values. Never commit .env.
POSTGRES_USER=catalog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=catalog
DATABASE_URL=postgresql+psycopg2://catalog:change-me@localhost:5432/catalog
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=generate-a-long-random-string

# Optional: background removal model (default isnet-general-use; see experiments/2026-11-14_rembg_models)
# REMBG_MODEL=birefnet-general-lite

# AI provider: "ollama" (default, free, local) or "claude" (needs ANTHROPIC_API_KEY)
# AI_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5vl:7b
# ANTHROPIC_API_KEY=your-anthropic-api-key
